#!/usr/bin/env bash
# handoff — drive the two-agent HANDOFF.md workflow without a human courier.
#
# The Status line in HANDOFF.md's Current Task section is the state machine:
#   READY FOR EXECUTION -> executor's turn
#   READY FOR QA        -> planner's turn
#   CHANGES REQUESTED   -> executor's turn
#   APPROVED            -> human's turn
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TEMPLATE_DIR="$SCRIPT_DIR/../templates"

# INVOCATION DISCIPLINE: the executor prompt is this fixed ritual phrase and
# nothing else. There is deliberately no flag, env var, or argument to add
# instructions — HANDOFF.md must remain the complete, auditable contract
# between the agents. Do not "improve" this.
readonly RITUAL_PROMPT="execute the handoff"

CLAUDE_BIN="${HANDOFF_CLAUDE_BIN:-claude}"
CLAUDE_MODEL="${HANDOFF_MODEL:-bedrock.claude-opus-4-8}"
POLL_INTERVAL="${HANDOFF_POLL_INTERVAL:-30}"
readonly CLI_OUTPUT_SCHEMA="urn:handoff-automation:cli-output:v1"
# The Executor must never run the Planner skill or this CLI (recursive
# dispatch). Denied per launch, not in .claude/settings.local.json, which a
# Claude Code Planner in the same repo also reads. Same list as the A2A
# Claude adapter (EXECUTOR_DISALLOWED_TOOLS).
readonly EXECUTOR_DISALLOWED_TOOLS="Bash(handoff:*),Bash(handoff-a2a:*),Bash(*/handoff:*),Bash(*/handoff-a2a:*),Skill(handoff-cli)"

usage() {
  cat <<'EOF'
usage: handoff <subcommand> [repo-path] [options]     (repo-path defaults to $PWD)

Start here (one-time bootstrap, then talk to your Planner agent):
  handoff skill install <repo> --host <cursor|codex|claude>     (or: --host <h> --user, no repo)
            makes the handoff-cli skill available to your Planner chat. Then say
            "/handoff-cli set up handoff in this repo": the skill asks for the
            Executor provider/model and the run mode (drive or watch), proposes
            managed A2A, and runs the commands below for you.
  handoff watch <repo>   the one command you keep running yourself in watch mode

Manual / scripted reference (the skill uses these; see docs/guides/cli-setup-and-models.md):

setup
  init      set up a repo. On a terminal it asks (Enter = managed A2A); scripted:
              handoff init <repo> --transport a2a --executor <claude|codex|cursor> \
                  --model "<model-id>" [--mode <drive|watch>] [--planner <cursor|codex|claude>] \
                  [--reasoning-effort <e>] [--port <n>]
              handoff init <repo> --transport legacy     (Python-free direct Claude)
            Generates every JSON/token/skill file; re-running preserves them.
  skill     handoff skill install <repo> --host <h> | --host <h> --user; handoff skill status <repo> [--json]
  models    handoff models <repo> --provider <name> [--json]: model IDs the installed CLI reports
  server    handoff server start|status|stop <repo> [--port <n>] [--json]: the managed local service
  model     handoff model <repo> [--json]: selected / active / pending Executor
            handoff model <repo> --provider <name> --model "<id>" [--after-current]
            handoff model <repo> --cancel-pending
  mode      handoff mode <repo> [drive|watch] [--json]: show or set the run mode (managed A2A)
  planner   handoff planner <repo> --provider cursor --model "<id>": interactive Cursor Planner
  permissions  merge the Claude executor allowlist into .claude/settings.local.json

workflow
  status    Markdown status, execution state, whose turn, run mode, and the Goal [--json]
  preflight list every execute blocker and its fix (managed A2A) [--json]
  approve   record plan approval (A2A receipt) or activate a legacy DRAFT
  execute   run the executor (only when it's the executor's turn) [--wait <seconds>]
  watch     poll Status; auto-execute on executor turns (refuses in drive mode)
  resume    reconnect to an outstanding A2A run [--wait <seconds>]
  cancel    request cancellation of an outstanding A2A run
  runs      list past executor runs from their manifests
  archive   append Current Task / Execution Notes / QA Feedback to HANDOFF-ARCHIVE.md
            handoff archive [repo] [--superseded]
            handoff archive list [repo] [--json]
            handoff archive show [repo] <task-id|index> [--section task|notes|qa] [--json]
            Refuses when that Current Task is already the last archived entry.
            (--superseded closes an exhausted A2A workflow)
  qa        handoff qa <repo> --status <APPROVED|CHANGES REQUESTED> --file <path> [--append] [--json]
            A2A only: replace QA Feedback and set Status. --append from READY FOR QA
            appends a round and sets Status; on APPROVED or CHANGES REQUESTED it leaves
            Status unchanged (legacy: edit HANDOFF.md by hand)
  template  handoff template refresh <repo> [--json]
            replace the HANDOFF.md preamble with the installed template's;
            Current Task and everything after it stay byte-for-byte

env: HANDOFF_CLAUDE_BIN (default: claude), HANDOFF_MODEL (legacy; default: bedrock.claude-opus-4-8),
     HANDOFF_CODEX_BIN, HANDOFF_CURSOR_BIN (provider CLIs for init/models/model),
     HANDOFF_POLL_INTERVAL seconds (default: 30), HANDOFF_A2A_BIN (A2A runtime executable)
EOF
}

die() { echo "handoff: $*" >&2; exit 1; }

HANDOFF_EXECUTE_LOCK=""
_handoff_release_execute() {
  if [[ -n "${HANDOFF_EXECUTE_LOCK:-}" ]]; then
    rmdir "$HANDOFF_EXECUTE_LOCK" 2>/dev/null || true
    HANDOFF_EXECUTE_LOCK=""
  fi
}

resolve_repo() {
  local repo="${1:-$PWD}"
  repo="$(cd "$repo" 2>/dev/null && pwd)" || die "no such directory: ${1:-$PWD}"
  [[ -f "$repo/HANDOFF.md" ]] || die "no HANDOFF.md in $repo (run 'handoff init $repo' first?)"
  echo "$repo"
}

# The only '**Status:**' line in the file lives in Current Task.
read_status() {
  sed -n 's/^\*\*Status:\*\* *//p' "$1/HANDOFF.md" | head -n 1 | sed 's/[[:space:]]*$//'
}

turn_for() {
  case "$1" in
    "READY FOR EXECUTION" | "CHANGES REQUESTED") echo "EXECUTOR" ;;
    "READY FOR QA") echo "PLANNER" ;;
    "APPROVED" | "DRAFT") echo "HUMAN" ;;
    *) echo "UNKNOWN" ;;
  esac
}

# First non-empty line after the '### Goal' heading.
read_goal() {
  awk '/^### Goal/ { found = 1; next } found && NF { print; exit }' "$1/HANDOFF.md"
}

handoff_transport() {
  local repo="$1"
  local cfg="$repo/.handoff-config.json"
  TRANSPORT="legacy"
  if [[ ! -f "$cfg" ]]; then
    return 0
  fi
  if git -C "$repo" ls-files --error-unmatch .handoff-config.json >/dev/null 2>&1; then
    die "$cfg is tracked in git; refuse to treat a committed credential reference as excluded"
  fi
  jq empty "$cfg" 2>/dev/null || die "malformed $cfg"
  local t
  t="$(jq -r '.transport // empty' "$cfg")"
  case "$t" in
    legacy) TRANSPORT="legacy" ;;
    a2a) TRANSPORT="a2a" ;;
    *) die "unknown or missing transport in $cfg (expected legacy or a2a)" ;;
  esac
}

is_a2a() {
  handoff_transport "$1"
  [[ "$TRANSPORT" == "a2a" ]]
}

# An outstanding A2A run stays authoritative for observation and recovery
# even after .handoff-config.json is switched to legacy, edited, or removed:
# its saved run record names the original endpoint and credential reference.
has_outstanding() {
  [[ -f "$1/.handoff-logs/outstanding.json" ]]
}

# A failed or canceled A2A delivery sets dispatch_hold in workflow.json. The
# hold outlives transport switches: watch never dispatches past it, and only an
# explicit `handoff execute` (after Planner review) clears it.
a2a_dispatch_held() {
  local wf="$1/.handoff-logs/workflow.json"
  [[ -f "$wf" ]] || return 1
  command -v jq >/dev/null || die "jq is required to read $wf (brew install jq)"
  [[ "$(jq -r 'if .dispatch_hold == true and .disposition == null then "held" else "" end' "$wf" 2>/dev/null)" == "held" ]]
}

clear_a2a_dispatch_hold() {
  local wf="$1/.handoff-logs/workflow.json"
  jq '.dispatch_hold = false' "$wf" > "$wf.tmp" && mv "$wf.tmp" "$wf"
  echo "explicit execute: cleared the A2A dispatch hold"
}

refuse_if_outstanding() {
  if has_outstanding "$1"; then
    die "outstanding A2A run exists; run 'handoff status', 'handoff resume', or 'handoff cancel' first"
  fi
}

resolve_a2a_bin() {
  local bin="${HANDOFF_A2A_BIN:-}"
  if [[ -n "$bin" ]]; then
    if [[ "$bin" == */* ]]; then
      [[ -x "$bin" ]] || die "HANDOFF_A2A_BIN is not executable: $bin"
    else
      command -v "$bin" >/dev/null 2>&1 || die "HANDOFF_A2A_BIN '$bin' is not on PATH"
    fi
    printf '%s\n' "$bin"
    return 0
  fi
  if command -v handoff-a2a >/dev/null 2>&1; then
    printf '%s\n' "handoff-a2a"
    return 0
  fi
  # This installation's own runtime (created by `uv sync` in the checkout).
  local own="$SCRIPT_DIR/../.venv/bin/handoff-a2a"
  if [[ -x "$own" ]]; then
    printf '%s\n' "$own"
    return 0
  fi
  die "the A2A runtime (handoff-a2a) is not installed. Set it up once with:
  (cd \"$(cd "$SCRIPT_DIR/.." && pwd)\" && uv sync)
or point HANDOFF_A2A_BIN at an existing handoff-a2a executable"
}

# True when the A2A runtime can be found, without dying (legacy stays Python-free).
a2a_available() {
  (resolve_a2a_bin >/dev/null 2>&1)
}

# One JSON error object on stdout for --json callers: kind, message, exit code.
json_die() {
  jq -n --arg schema "$CLI_OUTPUT_SCHEMA" --arg kind "$1" --arg error "$2" \
    '{schema: $schema, kind: $kind, error: $error}'
  exit "${3:-1}"
}

# Managed setup/service/selection verbs run in the Python runtime.
a2a_manage() {
  local command="$1"
  shift
  local bin
  bin="$(resolve_a2a_bin)"
  "$bin" "$command" "$@"
}

a2a_cli() {
  local repo="$1" command="$2"
  shift 2
  local bin
  bin="$(resolve_a2a_bin)"
  "$bin" cli --repo "$repo" "$command" "$@"
}

set_status_line() {
  local repo="$1" status="$2"
  local tmp
  tmp="$(mktemp)"
  sed -e "s/^\*\*Status:\*\*.*/**Status:** $status/" "$repo/HANDOFF.md" > "$tmp"
  mv "$tmp" "$repo/HANDOFF.md"
}

notify() { # title, body
  if command -v osascript >/dev/null 2>&1; then
    osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1 || true
  fi
  echo "NOTIFY: $1 — $2"
}

legacy_next() {
  case "$1" in
    DRAFT) echo "human plan review, then handoff approve" ;;
    "READY FOR EXECUTION" | "CHANGES REQUESTED") echo "handoff execute" ;;
    "READY FOR QA") echo "Planner QA" ;;
    APPROVED) echo "human merge; handoff archive" ;;
    *) echo "" ;;
  esac
}

cmd_status() {
  local repo_arg="" json=0 a
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      -*) die "unknown status option: $a (try --help)" ;;
      *) repo_arg="$a" ;;
    esac
  done
  local repo
  if [[ $json -eq 1 ]]; then
    command -v jq >/dev/null || die "jq is required for --json (brew install jq)"
    repo="$(cd "${repo_arg:-$PWD}" 2>/dev/null && pwd)" || json_die status "no such directory: ${repo_arg:-$PWD}"
    [[ -f "$repo/HANDOFF.md" ]] || json_die status "no HANDOFF.md in $repo (run 'handoff init $repo' first?)"
  else
    repo="$(resolve_repo "$repo_arg")"
  fi
  if has_outstanding "$repo" || is_a2a "$repo"; then
    if [[ $json -eq 1 ]]; then
      a2a_cli "$repo" status --json
    else
      a2a_cli "$repo" status
    fi
    return
  fi
  local status
  status="$(read_status "$repo")"
  if [[ $json -eq 1 ]]; then
    # Legacy stays Python-free: the same object shape, built with jq.
    jq -n --arg schema "$CLI_OUTPUT_SCHEMA" --arg repo "$repo" --arg status "$status" \
      --arg turn "$(turn_for "$status")" --arg goal "$(read_goal "$repo")" --arg next "$(legacy_next "$status")" \
      '{schema: $schema, kind: "status", repo: $repo, transport: "legacy", managed: false,
        status: (if $status == "" then null else $status end), turn: $turn, goal: $goal,
        execution: null, workflow: null, mode: null, watcher: null, executor: null, run: null,
        reason: null, next: (if $next == "" then null else $next end), preflight: null}'
    return
  fi
  echo "repo:   $repo"
  echo "status: ${status:-"(no Status line found)"}"
  echo "turn:   $(turn_for "$status")"
  echo "goal:   $(read_goal "$repo")"
  if [[ "$status" == "DRAFT" ]]; then
    echo "next:   human plan review, then handoff approve"
  fi
}

cmd_preflight() {
  local repo_arg="" json=0 a
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      -*) die "unknown preflight option: $a (try --help)" ;;
      *) repo_arg="$a" ;;
    esac
  done
  local repo
  if [[ $json -eq 1 ]]; then
    command -v jq >/dev/null || die "jq is required for --json (brew install jq)"
    repo="$(cd "${repo_arg:-$PWD}" 2>/dev/null && pwd)" || json_die preflight "no such directory: ${repo_arg:-$PWD}"
    [[ -f "$repo/HANDOFF.md" ]] || json_die preflight "no HANDOFF.md in $repo"
  else
    repo="$(resolve_repo "$repo_arg")"
  fi
  if is_a2a "$repo"; then
    if [[ $json -eq 1 ]]; then
      a2a_cli "$repo" preflight --json
    else
      a2a_cli "$repo" preflight
    fi
    return
  fi
  if [[ $json -eq 1 ]]; then
    json_die preflight "preflight needs managed A2A"
  fi
  die "preflight needs managed A2A"
}

# Positive number, at most 1800. Empty is "not passed".
validate_wait() {
  local value="$1"
  if [[ ! "$value" =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    die "--wait must be a positive number up to 1800"
  fi
  awk -v v="$value" 'BEGIN { if (!(v > 0 && v <= 1800)) exit 1 }' \
    || die "--wait must be a positive number up to 1800"
}

cmd_execute() {
  command -v jq >/dev/null || die "jq is required (brew install jq)"
  local repo_arg="" json=0 wait=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --wait)
        [[ $# -ge 2 ]] || die "--wait needs a positive number of seconds up to 1800"
        wait="$2"; shift 2 ;;
      --wait=*) wait="${1#*=}"; shift ;;
      -*) die "unknown execute option: $1 (try --help)" ;;
      *)
        [[ -z "$repo_arg" ]] || die "execute takes one repo path"
        repo_arg="$1"; shift ;;
    esac
  done
  [[ -z "$wait" ]] || validate_wait "$wait"
  local repo
  repo="$(resolve_repo "$repo_arg")"
  if is_a2a "$repo"; then
    local -a extra=()
    [[ -n "$wait" ]] && extra+=(--wait "$wait")
    [[ $json -eq 1 ]] && extra+=(--json)
    a2a_cli "$repo" execute ${extra[@]+"${extra[@]}"}
    return
  fi
  if [[ $json -eq 1 ]]; then
    die "execute --json needs managed A2A"
  fi
  if [[ -n "$wait" ]]; then
    die "--wait needs managed A2A"
  fi
  cmd_execute_legacy "$repo"
}

cmd_execute_legacy() {
  local repo="$1" status
  refuse_if_outstanding "$repo"
  status="$(read_status "$repo")"
  case "$status" in
    "READY FOR EXECUTION" | "CHANGES REQUESTED") ;;
    *) die "refusing to execute: Status is '$status' (need READY FOR EXECUTION or CHANGES REQUESTED)" ;;
  esac

  mkdir -p "$repo/.handoff-logs"

  local submit="$repo/.handoff-logs/submit.lock"
  local lock="$repo/.handoff-logs/execute.lock"
  if ! mkdir "$submit" 2>/dev/null; then
    die "another submission is in progress (or crashed): remove $submit to clear"
  fi
  if [[ -f "$repo/.handoff-logs/outstanding.json" ]]; then
    rmdir "$submit" 2>/dev/null || true
    die "outstanding A2A run exists; resume or cancel it instead of starting a legacy executor"
  fi
  if ! mkdir "$lock" 2>/dev/null; then
    rmdir "$submit" 2>/dev/null || true
    die "another executor run is in progress (or crashed): remove $lock to clear"
  fi
  rmdir "$submit" 2>/dev/null || true

  HANDOFF_EXECUTE_LOCK="$lock"
  # Release on any exit; on INT/TERM also stop (a signalled run must not keep
  # going without its lock, and watch must stay killable).
  trap '_handoff_release_execute' EXIT
  trap '_handoff_release_execute; exit 130' INT
  trap '_handoff_release_execute; exit 143' TERM
  if a2a_dispatch_held "$repo"; then
    clear_a2a_dispatch_hold "$repo"
  fi

  local run_id
  run_id="$(date +%Y%m%d-%H%M%S)-$$"
  local log="$repo/.handoff-logs/${run_id}-execute.log"
  local raw_result="$repo/.handoff-logs/${run_id}-result.json"
  local manifest="$repo/.handoff-logs/${run_id}-manifest.json"

  echo "executor starting in $repo (status: $status)"
  echo "run: $run_id"
  echo "log: $log"

  # Pre-run data capture
  local started_at branch_before head_before
  started_at="$(date +%FT%T%z)"
  branch_before="$(git -C "$repo" branch --show-current 2>/dev/null || echo "")"
  head_before="$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo "")"

  {
    echo "=== Executor run $run_id ==="
    echo "started: $started_at"
    echo "status:  $status"
    echo ""
  } > "$log"

  local start=$SECONDS rc=0
  (
    cd "$repo"
    # Strip inherited ANTHROPIC_*/CLAUDE* env so the executor always runs on
    # its own stored login — if this were invoked from inside another Claude
    # session (e.g. the planner's), leaked auth vars would silently run the
    # executor on the wrong account.
    local v
    for v in $(compgen -e | grep -E '^(ANTHROPIC_|CLAUDE)' || true); do unset "$v"; done
    "$CLAUDE_BIN" -p "$RITUAL_PROMPT" --permission-mode acceptEdits \
      --model "$CLAUDE_MODEL" \
      --disallowedTools "$EXECUTOR_DISALLOWED_TOOLS" \
      --output-format json > "$raw_result" 2>> "$log" || exit $?
  ) || rc=$?

  # Post-run data capture (still holding execute.lock)
  local dur=$((SECONDS - start))
  local finished_at branch_after head_after new_status
  finished_at="$(date +%FT%T%z)"
  branch_after="$(git -C "$repo" branch --show-current 2>/dev/null || echo "")"
  head_after="$(git -C "$repo" rev-parse HEAD 2>/dev/null || echo "")"
  new_status="$(read_status "$repo")"

  # Commits created during this run
  local commits_json="[]"
  if [[ -n "$head_before" && -n "$head_after" && "$head_before" != "$head_after" ]]; then
    local commit_lines
    commit_lines="$(git -C "$repo" log --format='%H%x09%s' "$head_before..$head_after" 2>/dev/null || echo "")"
    if [[ -n "$commit_lines" ]]; then
      # Determine GitHub base URL from origin remote
      local origin_url github_base=""
      origin_url="$(git -C "$repo" remote get-url origin 2>/dev/null || echo "")"
      if [[ "$origin_url" =~ github\.com[:/]([^/]+)/([^/]+) ]]; then
        local repo_name="${BASH_REMATCH[2]}"
        repo_name="${repo_name%.git}"
        github_base="https://github.com/${BASH_REMATCH[1]}/${repo_name}/commit"
      fi

      commits_json="$(echo "$commit_lines" | jq -R --arg base "$github_base" '
        split("\t") | {
          sha: .[0],
          subject: .[1],
          url: (if $base != "" then ($base + "/" + .[0]) else null end)
        }
      ' | jq -s '.')"
    fi
  fi

  # Parse claude result JSON (graceful degradation if invalid/missing)
  local claude_session_id claude_subtype claude_is_error claude_num_turns
  local claude_duration_ms claude_duration_api_ms claude_cost
  local claude_input_tokens claude_output_tokens
  local claude_cache_creation claude_cache_read claude_result_text
  claude_session_id="null"
  claude_subtype="null"
  claude_is_error="null"
  claude_num_turns="null"
  claude_duration_ms="null"
  claude_duration_api_ms="null"
  claude_cost="null"
  claude_input_tokens="null"
  claude_output_tokens="null"
  claude_cache_creation="null"
  claude_cache_read="null"
  claude_result_text=""

  if [[ -f "$raw_result" ]] && jq empty "$raw_result" 2>/dev/null; then
    claude_session_id="$(jq -r '.session_id // null' "$raw_result")"
    claude_subtype="$(jq -r '.subtype // null' "$raw_result")"
    claude_is_error="$(jq 'if has("is_error") then .is_error else null end' "$raw_result")"
    claude_num_turns="$(jq '.num_turns // null' "$raw_result")"
    claude_duration_ms="$(jq '.duration_ms // null' "$raw_result")"
    claude_duration_api_ms="$(jq '.duration_api_ms // null' "$raw_result")"
    claude_cost="$(jq '.total_cost_usd // null' "$raw_result")"
    claude_input_tokens="$(jq '.usage.input_tokens // null' "$raw_result")"
    claude_output_tokens="$(jq '.usage.output_tokens // null' "$raw_result")"
    claude_cache_creation="$(jq '.usage.cache_creation_input_tokens // null' "$raw_result")"
    claude_cache_read="$(jq '.usage.cache_read_input_tokens // null' "$raw_result")"
    claude_result_text="$(jq -r '.result // empty' "$raw_result")"
  fi

  # Write manifest
  jq -n \
    --arg run_id "$run_id" \
    --arg repo "$repo" \
    --arg trigger_status "$status" \
    --arg status_after "$new_status" \
    --arg started_at "$started_at" \
    --arg finished_at "$finished_at" \
    --argjson wall_duration_s "$dur" \
    --argjson exit_code "$rc" \
    --arg branch_before "$branch_before" \
    --arg branch_after "$branch_after" \
    --arg head_before "$head_before" \
    --arg head_after "$head_after" \
    --argjson commits "$commits_json" \
    --arg session_id "$claude_session_id" \
    --arg subtype "$claude_subtype" \
    --argjson is_error "$claude_is_error" \
    --argjson num_turns "$claude_num_turns" \
    --argjson duration_ms "$claude_duration_ms" \
    --argjson duration_api_ms "$claude_duration_api_ms" \
    --argjson total_cost_usd "$claude_cost" \
    --argjson input_tokens "$claude_input_tokens" \
    --argjson output_tokens "$claude_output_tokens" \
    --argjson cache_creation "$claude_cache_creation" \
    --argjson cache_read "$claude_cache_read" \
    --arg log_rel ".handoff-logs/${run_id}-execute.log" \
    --arg raw_rel ".handoff-logs/${run_id}-result.json" \
    '{
      run_id: $run_id,
      repo: $repo,
      trigger_status: $trigger_status,
      status_after: $status_after,
      started_at: $started_at,
      finished_at: $finished_at,
      wall_duration_s: $wall_duration_s,
      exit_code: $exit_code,
      git: {
        branch_before: (if $branch_before == "" then null else $branch_before end),
        branch_after: (if $branch_after == "" then null else $branch_after end),
        head_before: (if $head_before == "" then null else $head_before end),
        head_after: (if $head_after == "" then null else $head_after end),
        commits: $commits
      },
      claude: {
        session_id: (if $session_id == "null" then null else $session_id end),
        subtype: (if $subtype == "null" then null else $subtype end),
        is_error: $is_error,
        num_turns: $num_turns,
        duration_ms: $duration_ms,
        duration_api_ms: $duration_api_ms,
        total_cost_usd: $total_cost_usd,
        usage: {
          input_tokens: $input_tokens,
          output_tokens: $output_tokens,
          cache_creation_input_tokens: $cache_creation,
          cache_read_input_tokens: $cache_read
        }
      },
      files: {
        log: $log_rel,
        raw_result: $raw_rel
      }
    }' > "$manifest"

  # Human-readable summary
  local summary
  summary="$(printf '
── Run Summary ─────────────────────────────────────────
  run:      %s
  status:   %s → %s
  duration: %dm %ds (wall)
  exit:     %d
  tokens:   %s in / %s out' \
    "$run_id" \
    "$status" "$new_status" \
    $((dur / 60)) $((dur % 60)) \
    "$rc" \
    "$(jq -r 'if .claude.usage.input_tokens then (.claude.usage.input_tokens | tostring) else "n/a" end' "$manifest")" \
    "$(jq -r 'if .claude.usage.output_tokens then (.claude.usage.output_tokens | tostring) else "n/a" end' "$manifest")")"

  # Cached tokens line (only if present)
  local cached_in
  cached_in="$(jq -r '[.claude.usage.cache_creation_input_tokens, .claude.usage.cache_read_input_tokens] | map(select(. != null)) | if length > 0 then map(tostring) | join(" + ") else empty end' "$manifest")"
  if [[ -n "$cached_in" ]]; then
    summary+="$(printf ' (cached: %s)' "$cached_in")"
  fi

  summary+="$(printf '\n  cost:    %s' \
    "$(jq -r 'if .claude.total_cost_usd then ("$" + (.claude.total_cost_usd | tostring)) else "n/a" end' "$manifest")")"

  # Commits
  local commit_count
  commit_count="$(jq '.git.commits | length' "$manifest")"
  if [[ "$commit_count" -gt 0 ]]; then
    summary+="$(printf '\n  commits:')"
    while IFS=$'\t' read -r sha subject url; do
      local shortsha="${sha:0:7}"
      if [[ "$url" != "null" && -n "$url" ]]; then
        summary+="$(printf '\n    %s %s\n         %s' "$shortsha" "$subject" "$url")"
      else
        summary+="$(printf '\n    %s %s' "$shortsha" "$subject")"
      fi
    done < <(jq -r '.git.commits[] | [.sha, .subject, (.url // "null")] | @tsv' "$manifest")
  fi

  summary+="$(printf '\n  manifest: %s\n────────────────────────────────────────────────────────\n' "$manifest")"

  # Print summary to stdout and append to log
  echo "$summary"

  {
    echo ""
    if [[ -n "$claude_result_text" ]]; then
      echo "=== Executor Result ==="
      echo "$claude_result_text"
      echo ""
    fi
    echo "$summary"
  } >> "$log"

  _handoff_release_execute
  trap - EXIT INT TERM
  return "$rc"
}

cmd_runs() {
  command -v jq >/dev/null || die "jq is required (brew install jq)"

  local repo
  repo="$(resolve_repo "${1:-}")"

  local manifests=()
  while IFS= read -r f; do
    manifests+=("$f")
  done < <(find "$repo/.handoff-logs" -name '*-manifest.json' -type f 2>/dev/null | sort)

  if [[ ${#manifests[@]} -eq 0 ]]; then
    echo "no runs found in $repo/.handoff-logs/"
    return 0
  fi

  printf '%-22s  %-24s  %6s  %4s  %8s  %8s  %8s  %-16s  %-7s  %s\n' \
    "RUN ID" "FINISHED" "WALL" "EXIT" "IN TOK" "OUT TOK" "COST" "STATUS AFTER" "COMMITS" "EXECUTOR"
  printf '%-22s  %-24s  %6s  %4s  %8s  %8s  %8s  %-16s  %-7s  %s\n' \
    "------" "--------" "----" "----" "------" "-------" "----" "------------" "-------" "--------"

  local m
  for m in "${manifests[@]}"; do
    jq -r '[
      .run_id,
      (if .finished_at then .finished_at else "n/a" end),
      (if .wall_duration_s == null then "n/a" else (.wall_duration_s | "\(. / 60 | floor)m \(. % 60)s") end),
      (if .exit_code == null then "n/a" else (.exit_code | tostring) end),
      (if (.claude.usage.input_tokens != null) then (.claude.usage.input_tokens | tostring)
       elif (.usage.input_tokens != null) then (.usage.input_tokens | tostring)
       else "n/a" end),
      (if (.claude.usage.output_tokens != null) then (.claude.usage.output_tokens | tostring)
       elif (.usage.output_tokens != null) then (.usage.output_tokens | tostring)
       else "n/a" end),
      (if (.claude.total_cost_usd != null) then ("$" + (.claude.total_cost_usd | tostring))
       elif (.cost_usd != null) then ("$" + (.cost_usd | tostring))
       else "n/a" end),
      (.status_after // .outcome // "n/a"),
      ((.git.commits // []) | length | tostring),
      (if (.executor.provider != null) then
         (.executor.provider + "/" + (.executor.model // "?")
          + (if .executor.config_generation != null then " g" + (.executor.config_generation | tostring) else "" end))
       else "n/a" end)
    ] | @tsv' "$m" | while IFS=$'\t' read -r rid fin wall ex itin outk cost sa cc exe; do
      printf '%-22s  %-24s  %6s  %4s  %8s  %8s  %8s  %-16s  %-7s  %s\n' \
        "$rid" "$fin" "$wall" "$ex" "$itin" "$outk" "$cost" "$sa" "$cc" "$exe"
    done
  done
}

cmd_watch() {
  local repo
  repo="$(resolve_repo "${1:-}")"
  if is_a2a "$repo"; then
    a2a_cli "$repo" watch --interval "$POLL_INTERVAL"
    return
  fi
  local last="" status
  echo "watching $repo/HANDOFF.md every ${POLL_INTERVAL}s (Ctrl-C to stop)"
  while true; do
    if has_outstanding "$repo"; then
      # Observe (and reconcile a terminal) run through its saved record; never
      # dispatch while it is outstanding.
      echo "outstanding A2A run present; watch will not dispatch until it is reconciled"
      a2a_cli "$repo" status || true
      last=""
      sleep "$POLL_INTERVAL"
      continue
    fi
    status="$(read_status "$repo")"
    if [[ "$status" != "$last" ]]; then
      echo "[$(date +%H:%M:%S)] status: $status ($(turn_for "$status")'s turn)"
      case "$status" in
        "READY FOR EXECUTION" | "CHANGES REQUESTED")
          if a2a_dispatch_held "$repo"; then
            echo "execute held after a failed/canceled A2A delivery; watch will not retry (Planner review, then explicit 'handoff execute')"
          elif ! cmd_execute "$repo"; then
            # Don't hot-loop a failing executor: wait for the status (or a
            # human) to change something before trying again.
            echo "execute failed; watching for the next status change"
          fi
          ;;
        "READY FOR QA" | "APPROVED")
          notify "Handoff: $status" "$(read_goal "$repo")"
          ;;
      esac
      last="$status" # if execute changed the status, next poll handles the new state
    fi
    sleep "$POLL_INTERVAL"
  done
}

# Whole-line heading count. A trailing CR still matches (grep -x).
heading_count() {
  local file="$1" heading="$2"
  grep -c -x -e "$heading" -e "$(printf '%s\r' "$heading")" "$file" || true
}

heading_line() {
  local file="$1" heading="$2"
  grep -n -x -e "$heading" -e "$(printf '%s\r' "$heading")" "$file" | head -n 1 | cut -d: -f1
}

refuse_malformed_structure() {
  local file="$1" heading count ct en qa
  for heading in "## Current Task" "## Execution Notes" "## QA Feedback"; do
    count="$(heading_count "$file" "$heading")"
    if [[ "$count" -eq 0 ]]; then
      die "\`$heading\` is missing"
    fi
    if [[ "$count" -ne 1 ]]; then
      die "\`$heading\` appears ${count} times"
    fi
  done
  ct="$(heading_line "$file" "## Current Task")"
  en="$(heading_line "$file" "## Execution Notes")"
  qa="$(heading_line "$file" "## QA Feedback")"
  if [[ "$ct" -ge "$en" || "$en" -ge "$qa" ]]; then
    die "HANDOFF.md headings are out of order: ## Current Task, ## Execution Notes, ## QA Feedback"
  fi
}

cmd_qa() {
  local repo="" status="" qa_file="" append=0 json=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --status)
        [[ $# -ge 2 ]] || die "qa --status needs APPROVED or CHANGES REQUESTED"
        status="$2"
        shift 2
        ;;
      --file)
        [[ $# -ge 2 ]] || die "qa --file needs a path"
        qa_file="$2"
        shift 2
        ;;
      --append) append=1; shift ;;
      --json) json=1; shift ;;
      --*) die "unknown qa option: $1 (try --help)" ;;
      *)
        [[ -z "$repo" ]] || die "qa takes one repo path"
        repo="$1"
        shift
        ;;
    esac
  done
  [[ -n "$status" && -n "$qa_file" ]] || die "qa requires --status and --file"
  repo="$(resolve_repo "${repo:-}")"
  if ! is_a2a "$repo"; then
    local msg="handoff qa is A2A only; on legacy, edit Status and QA Feedback in HANDOFF.md by hand"
    if [[ "$json" -eq 1 ]]; then
      json_die qa "$msg"
    fi
    die "$msg"
  fi
  local -a extra=()
  [[ "$append" -eq 1 ]] && extra+=(--append)
  [[ "$json" -eq 1 ]] && extra+=(--json)
  a2a_cli "$repo" qa --status "$status" --file "$qa_file" ${extra[@]+"${extra[@]}"}
}

# An entry starts at `# Archived ` or `# Superseded ` and stops before the next
# one. The writer's `\n---\n\n` separator in front of that next header is not
# part of the entry. list/show stay in bash so legacy does not need Python.
archive_tool() {
  local mode="$1" selector="${2:-}" section="${3:-}" bodyfile="${4:-}" keyfile="${5:-}" file="$6"
  LC_ALL=C awk \
    -v mode="$mode" -v selector="$selector" -v section="$section" \
    -v bodyfile="$bodyfile" -v keyfile="$keyfile" '
function jesc(s,    i, c, o, n) {
  o = ""
  n = length(s)
  for (i = 1; i <= n; i++) {
    c = substr(s, i, 1)
    if (c == "\\") o = o "\\\\"
    else if (c == "\"") o = o "\\\""
    else if (c == "\r") o = o "\\r"
    else if (c == "\n") o = o "\\n"
    else if (c == "\t") o = o "\\t"
    else o = o c
  }
  return o
}
function jstr(s) { return "\"" jesc(s) "\"" }
function jopt(has, s) { if (has) return jstr(s); return "null" }
function entry_end(start, nxt,    e) {
  e = nxt - 1
  while (e > start && line[e] == "") e--
  if (e > start && line[e] == "---") {
    e--
    if (e > start && line[e] == "") e--
  } else {
    e = nxt - 1
  }
  if (e < start) return start
  return e
}
function span_bytes(from, to,    i, n) {
  n = 0
  if (to < from) return 0
  for (i = from; i <= to; i++) n += length(raw[i]) + 1
  return n
}
function write_span(from, to, dest,    i) {
  if (to < from || dest == "") return
  for (i = from; i <= to; i++) printf "%s\n", raw[i] > dest
  close(dest)
}
function find_exact(from, to, exact,    i) {
  if (from < 1) return 0
  for (i = from; i <= to; i++) if (line[i] == exact) return i
  return 0
}
function is_h2(s) { return substr(s, 1, 3) == "## " && length(s) > 3 }
function write_task_key(from, to, dest,    i, begin, stop) {
  begin = 0
  for (i = from; i <= to; i++) if (line[i] == "## Current Task") { begin = i; break }
  if (begin == 0 || dest == "") return 0
  stop = to
  for (i = begin + 1; i <= to; i++) if (is_h2(line[i])) { stop = i - 1; break }
  for (i = begin; i <= stop; i++) {
    if (line[i] ~ /^\*\*Status:\*\*/) printf "**Status:**\n" > dest
    else printf "%s\n", line[i] > dest
  }
  close(dest)
  return 1
}
function parse_header(s,    rest, outer, chunk) {
  hk_kind = ""
  hk_date = ""
  hk_goal = ""
  if (substr(s, 1, 11) == "# Archived ") {
    hk_kind = "archived"
    rest = substr(s, 12)
  } else if (substr(s, 1, 13) == "# Superseded ") {
    hk_kind = "superseded"
    rest = substr(s, 14)
  } else {
    return 0
  }
  if (match(rest, /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9] — /) \
      || match(rest, /^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] — /)) {
    outer = RLENGTH
    chunk = substr(rest, 1, outer)
    if (match(chunk, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]/))
      hk_date = substr(chunk, RSTART, RLENGTH)
    else if (match(chunk, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/))
      hk_date = substr(chunk, RSTART, RLENGTH)
    hk_goal = substr(rest, outer + 1)
    return 1
  }
  if (match(rest, /^— [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9] — /) \
      || match(rest, /^— [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] — /)) {
    outer = RLENGTH
    chunk = substr(rest, 1, outer)
    if (match(chunk, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9] [0-9][0-9]:[0-9][0-9]/))
      hk_date = substr(chunk, RSTART, RLENGTH)
    else if (match(chunk, /[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/))
      hk_date = substr(chunk, RSTART, RLENGTH)
    hk_goal = substr(rest, outer + 1)
    return 1
  }
  hk_goal = rest
  return 1
}
function take_field(s, prefix,    value) {
  if (index(s, prefix) != 1) return ""
  value = substr(s, length(prefix) + 1)
  sub(/^[[:space:]]+/, "", value)
  sub(/[[:space:]]+$/, "", value)
  return value
}
function emit_obj(e) {
  return "{\"index\":" idx[e] \
    ",\"archived_at\":" jopt(date[e] != "", date[e]) \
    ",\"kind\":" jstr(kind[e]) \
    ",\"task_id\":" jopt(has_task[e], task[e]) \
    ",\"goal\":" jstr(goal[e]) \
    ",\"disposition\":" jopt(has_disp[e], disp[e]) \
    ",\"workflow_id\":" jopt(has_wf[e], wf[e]) \
    ",\"bytes\":" bytes[e] "}"
}
{
  raw[NR] = $0
  line[NR] = $0
  sub(/\r$/, "", line[NR])
}
END {
  n = 0
  for (i = 1; i <= NR; i++) {
    if (substr(line[i], 1, 11) == "# Archived " || substr(line[i], 1, 13) == "# Superseded ") {
      n++
      h[n] = i
    }
  }
  for (e = 1; e <= n; e++) {
    start[e] = h[e]
    if (e < n) end[e] = entry_end(h[e], h[e + 1])
    else end[e] = NR
    parse_header(line[h[e]])
    idx[e] = e
    kind[e] = hk_kind
    date[e] = hk_date
    goal[e] = hk_goal
    has_task[e] = 0
    has_disp[e] = 0
    has_wf[e] = 0
    task[e] = ""
    disp[e] = ""
    wf[e] = ""
    for (i = start[e]; i <= end[e]; i++) {
      if (!has_task[e] && index(line[i], "**Task ID:**") == 1) {
        has_task[e] = 1
        task[e] = take_field(line[i], "**Task ID:**")
      }
      if (!has_disp[e] && index(line[i], "Disposition:") == 1) {
        has_disp[e] = 1
        disp[e] = take_field(line[i], "Disposition:")
      }
      if (!has_wf[e] && index(line[i], "Workflow-ID:") == 1) {
        has_wf[e] = 1
        wf[e] = take_field(line[i], "Workflow-ID:")
      }
    }
    bytes[e] = span_bytes(start[e], end[e])
  }
  sep = sprintf("%c", 31)
  if (mode == "list-text") {
    for (e = 1; e <= n; e++) {
      shown = has_task[e] ? task[e] : ""
      printf "%d%s%s%s%s%s%s%s%d%s%s\n", idx[e], sep, date[e], sep, shown, sep, kind[e], sep, bytes[e], sep, goal[e]
    }
    exit 0
  }
  if (mode == "list-json") {
    printf "["
    for (e = 1; e <= n; e++) {
      if (e > 1) printf ","
      printf "%s", emit_obj(e)
    }
    printf "]\n"
    exit 0
  }
  if (mode == "key-handoff") {
    write_task_key(1, NR, keyfile)
    exit 0
  }
  if (mode == "key-archive") {
    if (n == 0) { print "NONE"; exit 0 }
    if (!write_task_key(h[n], NR, keyfile)) { print "NONE"; exit 0 }
    printf "%d\t%s\n", n, date[n]
    exit 0
  }
  if (mode != "show") exit 0
  chosen = 0
  matches = 0
  listed = ""
  for (e = 1; e <= n; e++) {
    if (has_task[e] && task[e] == selector) {
      matches++
      if (listed != "") listed = listed ", "
      listed = listed e
      chosen = e
    }
  }
  if (matches > 1) {
    print "handoff: " matches " entries match " selector " (indexes " listed ")" > "/dev/stderr"
  } else if (matches == 0 && selector ~ /^[1-9][0-9]*$/ && selector + 0 <= n) {
    chosen = selector + 0
  }
  if (chosen == 0) { print "MISSING"; exit 0 }
  from = start[chosen]
  to = end[chosen]
  if (section == "task" || section == "notes" || section == "qa") {
    ct = find_exact(start[chosen], end[chosen], "## Current Task")
    en = 0
    qa = 0
    if (ct > 0) en = find_exact(ct + 1, end[chosen], "## Execution Notes")
    if (en > 0) qa = find_exact(en + 1, end[chosen], "## QA Feedback")
    if (section == "task") {
      if (ct == 0 || en == 0) { print "NOSECTION"; exit 0 }
      from = ct
      to = en - 1
    } else if (section == "notes") {
      if (en == 0 || qa == 0) { print "NOSECTION"; exit 0 }
      from = en
      to = qa - 1
    } else {
      if (qa == 0) { print "NOSECTION"; exit 0 }
      from = qa
      to = end[chosen]
    }
  }
  write_span(from, to, bodyfile)
  print emit_obj(chosen)
  exit 0
}
' "$file"
}

archive_print_list() {
  local index date task_id kind bytes goal prefix line room
  while IFS=$'\037' read -r index date task_id kind bytes goal; do
    [[ -n "$index" ]] || continue
    [[ -n "$task_id" ]] || task_id="-"
    prefix="$index $date $task_id $kind $bytes "
    line="$prefix$goal"
    if ((${#line} > 120)); then
      room=$((120 - ${#prefix} - 3))
      if ((room < 0)); then room=0; fi
      goal="${goal:0:room}..."
      line="$prefix$goal"
    fi
    printf '%s\n' "$line"
  done
}

archive_fail() {
  local kind="$1" message="$2" json="$3"
  if [[ "$json" -eq 1 ]]; then
    json_die "$kind" "$message"
  fi
  die "$message"
}

refuse_duplicate_archive() {
  local handoff="$1" archive="$2" hk ak meta index stamp
  hk="$(mktemp "${TMPDIR:-/tmp}/handoff-task-key.XXXXXX")"
  ak="$(mktemp "${TMPDIR:-/tmp}/handoff-task-key.XXXXXX")"
  archive_tool key-handoff "" "" "" "$hk" "$handoff" >/dev/null
  meta="$(archive_tool key-archive "" "" "" "$ak" "$archive")"
  if [[ "$meta" == NONE || ! -s "$hk" || ! -s "$ak" ]]; then
    rm -f "$hk" "$ak"
    return 0
  fi
  if cmp -s "$hk" "$ak"; then
    index="${meta%%$'\t'*}"
    stamp="${meta#*$'\t'}"
    rm -f "$hk" "$ak"
    die "already archived as entry ${index} (${stamp}); plan the next task first"
  fi
  rm -f "$hk" "$ak"
}

cmd_archive_list() {
  local repo="" json=0 archive entries
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --*) die "unknown archive list option: $1 (try --help)" ;;
      *)
        [[ -z "$repo" ]] || die "archive list takes one repo path"
        repo="$1"
        shift
        ;;
    esac
  done
  repo="$(resolve_repo "$repo")"
  archive="$repo/HANDOFF-ARCHIVE.md"
  if [[ "$json" -eq 1 ]]; then
    command -v jq >/dev/null || die "jq is required for --json (brew install jq)"
  fi
  if [[ ! -f "$archive" ]]; then
    if [[ "$json" -eq 1 ]]; then
      jq -n --arg schema "$CLI_OUTPUT_SCHEMA" --arg repo "$repo" \
        '{schema: $schema, kind: "archive_list", repo: $repo, entries: []}'
    else
      echo "no archive yet"
    fi
    return 0
  fi
  if [[ "$json" -eq 1 ]]; then
    entries="$(archive_tool list-json "" "" "" "" "$archive")"
    jq -n --arg schema "$CLI_OUTPUT_SCHEMA" --arg repo "$repo" --argjson entries "$entries" \
      '{schema: $schema, kind: "archive_list", repo: $repo, entries: $entries}'
  else
    archive_tool list-text "" "" "" "" "$archive" | archive_print_list
  fi
}

cmd_archive_show() {
  local repo="" selector="" section="" json=0 archive body meta
  local -a pos=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --section)
        [[ $# -ge 2 ]] || die "archive show --section needs task, notes, or qa"
        section="$2"
        shift 2
        ;;
      --section=*) section="${1#*=}"; shift ;;
      --*) die "unknown archive show option: $1 (try --help)" ;;
      *) pos+=("$1"); shift ;;
    esac
  done
  case "$section" in
    ""|task|notes|qa) ;;
    *) die "unknown archive section: $section (task, notes, or qa)" ;;
  esac
  if [[ ${#pos[@]} -eq 1 && -d "${pos[0]}" ]]; then
    die "archive show needs a task id or index"
  fi
  case "${#pos[@]}" in
    1) selector="${pos[0]}" ;;
    2) repo="${pos[0]}"; selector="${pos[1]}" ;;
    *) die "usage: handoff archive show [repo] <task-id|index> [--section task|notes|qa] [--json]" ;;
  esac
  [[ -n "$selector" ]] || die "archive show needs a task id or index"
  repo="$(resolve_repo "$repo")"
  if [[ "$json" -eq 1 ]]; then
    command -v jq >/dev/null || die "jq is required for --json (brew install jq)"
  fi
  archive="$repo/HANDOFF-ARCHIVE.md"
  if [[ ! -f "$archive" ]]; then
    archive_fail archive_show "no archived task ${selector}; see handoff archive list" "$json"
  fi
  body="$(mktemp "${TMPDIR:-/tmp}/handoff-archive-entry.XXXXXX")"
  meta="$(archive_tool show "$selector" "$section" "$body" "" "$archive")"
  if [[ "$meta" == MISSING ]]; then
    rm -f "$body"
    archive_fail archive_show "no archived task ${selector}; see handoff archive list" "$json"
  fi
  if [[ "$meta" == NOSECTION ]]; then
    rm -f "$body"
    archive_fail archive_show "no ${section} section in archived task ${selector}" "$json"
  fi
  if [[ "$json" -eq 1 ]]; then
    if [[ -n "$section" ]]; then
      jq -n --arg schema "$CLI_OUTPUT_SCHEMA" --arg repo "$repo" --argjson entry "$meta" \
        --arg section "$section" --rawfile text "$body" \
        '{schema: $schema, kind: "archive_show", repo: $repo, entry: $entry, section: $section, text: $text}'
    else
      jq -n --arg schema "$CLI_OUTPUT_SCHEMA" --arg repo "$repo" --argjson entry "$meta" \
        --rawfile text "$body" \
        '{schema: $schema, kind: "archive_show", repo: $repo, entry: $entry, section: null, text: $text}'
    fi
  else
    cat "$body"
  fi
  rm -f "$body"
}

cmd_archive() {
  if [[ "${1:-}" == "list" ]]; then
    shift
    cmd_archive_list "$@"
    return
  fi
  if [[ "${1:-}" == "show" ]]; then
    shift
    cmd_archive_show "$@"
    return
  fi
  local superseded=0 repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --superseded) superseded=1 ;;
      *) repo="$1" ;;
    esac
    shift
  done
  repo="$(resolve_repo "${repo:-}")"
  if is_a2a "$repo"; then
    if [[ "$superseded" -eq 1 ]]; then
      a2a_cli "$repo" archive --superseded
    else
      a2a_cli "$repo" archive
    fi
    return
  fi
  if [[ "$superseded" -eq 1 ]]; then
    die "archive --superseded requires A2A workflow state"
  fi
  refuse_if_outstanding "$repo"
  refuse_malformed_structure "$repo/HANDOFF.md"
  local archive goal
  archive="$repo/HANDOFF-ARCHIVE.md"
  if [[ -f "$archive" ]]; then
    refuse_duplicate_archive "$repo/HANDOFF.md" "$archive"
  fi
  goal="$(read_goal "$repo")"
  if [[ ! -f "$archive" ]]; then
    printf '# HANDOFF Archive\n\nCompleted tasks, appended verbatim by `handoff archive`. Local-only (git-excluded).\n' > "$archive"
  fi
  {
    printf '\n---\n\n# Archived %s — %s\n\n' "$(date '+%Y-%m-%d %H:%M')" "${goal:-"(no goal)"}"
    # Current Task through QA Feedback are the last sections of the file.
    awk '/^## Current Task/ { found = 1 } found' "$repo/HANDOFF.md"
  } >> "$archive"
  echo "archived '$goal' to $archive"
}

cmd_approve() {
  local repo
  repo="$(resolve_repo "${1:-}")"
  if is_a2a "$repo"; then
    a2a_cli "$repo" approve
    return
  fi
  refuse_if_outstanding "$repo"
  local status
  status="$(read_status "$repo")"
  case "$status" in
    DRAFT)
      set_status_line "$repo" "READY FOR EXECUTION"
      echo "legacy approval: Status set to READY FOR EXECUTION"
      ;;
    "READY FOR EXECUTION" | "CHANGES REQUESTED")
      echo "legacy approval: Status is already $status"
      ;;
    *)
      die "legacy approve only activates a DRAFT (status is '$status')"
      ;;
  esac
}

# resume/cancel act on the saved run (endpoint, request, credential reference),
# not on whatever transport is configured now.
cmd_resume() {
  local repo_arg="" json=0 wait=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --wait)
        [[ $# -ge 2 ]] || die "--wait needs a positive number of seconds up to 1800"
        wait="$2"; shift 2 ;;
      --wait=*) wait="${1#*=}"; shift ;;
      -*) die "unknown resume option: $1 (try --help)" ;;
      *)
        [[ -z "$repo_arg" ]] || die "resume takes one repo path"
        repo_arg="$1"; shift ;;
    esac
  done
  [[ -z "$wait" ]] || validate_wait "$wait"
  local repo
  repo="$(resolve_repo "$repo_arg")"
  has_outstanding "$repo" || is_a2a "$repo" || die "resume requires an outstanding A2A run or A2A configuration"
  local -a extra=()
  [[ -n "$wait" ]] && extra+=(--wait "$wait")
  [[ $json -eq 1 ]] && extra+=(--json)
  a2a_cli "$repo" resume ${extra[@]+"${extra[@]}"}
}

cmd_cancel() {
  local repo
  repo="$(resolve_repo "${1:-}")"
  has_outstanding "$repo" || is_a2a "$repo" || die "cancel requires an outstanding A2A run or A2A configuration"
  a2a_cli "$repo" cancel
}

# Merge the executor's permission rules into the repo's
# .claude/settings.local.json — the machine-local settings file Claude Code
# keeps out of git — preserving anything already there. Deliberately NOT the
# shared settings.json: the handoff machinery is this machine's workflow, not
# the project's (same reasoning as .git/info/exclude over .gitignore). The JS
# package manager is detected from the repo's lockfile so the allow rules
# match the project's actual toolchain (the executor runs headless, so any
# command outside these rules fails rather than prompting).
cmd_permissions() {
  command -v jq >/dev/null || die "jq is required (brew install jq)"
  local repo="${1:-$PWD}"
  repo="$(cd "$repo" 2>/dev/null && pwd)" || die "no such directory: ${1:-$PWD}"

  local pm=""
  if [[ -f "$repo/yarn.lock" ]]; then
    pm="yarn"
  elif [[ -f "$repo/pnpm-lock.yaml" ]]; then
    pm="pnpm"
  elif [[ -f "$repo/package-lock.json" ]]; then
    pm="npm"
  fi

  # Base rules: edits, navigation, local-only git. `cd` is included because
  # scripts often live in subpackages — a compound command like
  # `cd backend && yarn test` is only allowed if every part is.
  local -a allow=(
    "Edit" "Write" "Bash(cd:*)"
    "Bash(git add:*)" "Bash(git commit:*)"
    "Bash(git status)" "Bash(git status:*)"
    "Bash(git diff)" "Bash(git diff:*)"
    "Bash(git log)" "Bash(git log:*)"
  )

  # Verification scripts the executor may run itself. Deliberately a fixed
  # safe list — repo-specific extras (e.g. migration:generate) are a human
  # decision; add those to .claude/settings.local.json by hand.
  local -a scripts=(test lint check typecheck build pre-commit format)
  local s
  case "$pm" in
    yarn | pnpm)
      for s in "${scripts[@]}"; do allow+=("Bash($pm $s)" "Bash($pm $s:*)"); done
      ;;
    npm)
      allow+=("Bash(npm test)" "Bash(npm test:*)")
      for s in "${scripts[@]}"; do allow+=("Bash(npm run $s)" "Bash(npm run $s:*)"); done
      ;;
  esac
  if [[ -n "$pm" ]]; then
    allow+=("Bash(npx vitest:*)" "Bash(npx tsc:*)" "Bash(npx eslint:*)" "Bash(npx tsx:*)")
  fi

  # Publishing requires explicit human authorization written into the task —
  # and even then a human runs it. Deny beats allow in Claude Code.
  local -a deny=("Bash(git push:*)" "Bash(git merge:*)" "Bash(gh pr create:*)")

  local allow_json deny_json
  allow_json="$(printf '%s\n' "${allow[@]}" | jq -R . | jq -s .)"
  deny_json="$(printf '%s\n' "${deny[@]}" | jq -R . | jq -s .)"

  local settings="$repo/.claude/settings.local.json"
  mkdir -p "$repo/.claude"
  if [[ -f "$settings" ]]; then
    jq empty "$settings" 2>/dev/null || die "$settings is not valid JSON — fix it before merging"
    # Append-and-dedupe, preserving the order of anything already present.
    jq --argjson allow "$allow_json" --argjson deny "$deny_json" '
      .permissions.allow = ((.permissions.allow // []) + $allow
        | reduce .[] as $r ([]; if index($r) == null then . + [$r] else . end))
      | .permissions.deny = ((.permissions.deny // []) + $deny
        | reduce .[] as $r ([]; if index($r) == null then . + [$r] else . end))
    ' "$settings" > "$settings.tmp"
    mv "$settings.tmp" "$settings"
    echo "merged executor permissions into $settings (existing settings preserved)"
  else
    jq -n --argjson allow "$allow_json" --argjson deny "$deny_json" \
      '{permissions: {allow: $allow, deny: $deny}}' > "$settings"
    echo "created $settings with executor permissions"
  fi
  echo "toolchain: ${pm:-"none detected — git/edit rules only; add your build tool's commands by hand"}"
  echo "review:    cat $settings   (local-only; not part of the repo's git history)"
}

# Local exclude file via git plumbing: linked worktrees have a .git *file*.
git_exclude_file() {
  git -C "$1" rev-parse --path-format=absolute --git-path info/exclude
}

ensure_excludes() {
  local repo="$1" exclude p
  shift
  exclude="$(git_exclude_file "$repo")" || die "cannot locate the git exclude file for $repo"
  mkdir -p "$(dirname "$exclude")"
  for p in "$@"; do
    grep -qxF "$p" "$exclude" 2>/dev/null || echo "$p" >> "$exclude"
  done
}

skill_dir_for() {
  case "$1" in
    cursor) echo ".cursor/skills/handoff-cli" ;;
    codex) echo ".agents/skills/handoff-cli" ;;
    claude) echo ".claude/skills/handoff-cli" ;;
    *) die "unknown Planner host '$1' (cursor, codex, or claude)" ;;
  esac
}

# Install the repository-owned Planner skill for a host (legacy init path; A2A
# init does this in Python). With the A2A runtime present, the one Python
# installer runs (markers, upgrades). Without it, legacy stays Python-free: a
# fresh copy only, never over an unrelated, modified, or tracked skill.
install_planner_skill_legacy() {
  local repo="$1" host="$2" rel
  rel="$(skill_dir_for "$host")"
  if a2a_available; then
    a2a_manage skill install "$repo" --host "$host"
    return
  fi
  local src="$SCRIPT_DIR/../skills/handoff-cli" dest="$repo/$rel"
  if [[ -e "$dest" || -L "$dest" ]]; then
    if [[ ! -L "$dest" ]] && [[ -z "$(git -C "$repo" ls-files -- "$rel")" ]] \
      && diff -rq -x .handoff-skill.json "$src" "$dest" >/dev/null 2>&1; then
      echo "planner skill already installed: $dest"
      return 0
    fi
    die "$rel already exists with different or tracked content; not overwriting it (upgrades need the A2A runtime: uv sync, then handoff skill install)"
  fi
  mkdir -p "$(dirname "$dest")"
  cp -R "$src" "$dest"
  ensure_excludes "$repo" "$rel/"
  echo "installed Planner skill: $dest (project-local; type /handoff-cli in your Planner chat)"
}

cmd_skill() {
  a2a_available || die "handoff skill needs the A2A runtime (handoff-a2a). Set it up once with:
  (cd \"$(cd "$SCRIPT_DIR/.." && pwd)\" && uv sync)"
  a2a_manage skill "$@"
}

legacy_mode_hint() {
  echo "handoff init \"$1\" --transport a2a --executor <claude|codex|cursor> --model \"<model-id>\" --mode <drive|watch>"
}

# Run mode is managed-A2A configuration. The legacy answer is Python-free.
cmd_mode() {
  local repo_arg="" value="" json=0 a npos=0
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      -*) die "unknown mode option: $a (try --help)" ;;
      *)
        npos=$((npos + 1))
        case "$npos" in
          1) repo_arg="$a" ;;
          2) value="$a" ;;
          *) die "mode takes a repo and an optional drive|watch" ;;
        esac
        ;;
    esac
  done
  case "$value" in "" | drive | watch) ;; *) die "unknown run mode '$value' (drive or watch)" ;; esac
  local repo
  if [[ $json -eq 1 ]]; then
    command -v jq >/dev/null || die "jq is required for --json (brew install jq)"
    repo="$(cd "${repo_arg:-$PWD}" 2>/dev/null && pwd)" || json_die mode "no such directory: ${repo_arg:-$PWD}"
    [[ -f "$repo/HANDOFF.md" ]] || json_die mode "no HANDOFF.md in $repo (run 'handoff init $repo' first?)"
  else
    repo="$(resolve_repo "$repo_arg")"
  fi
  handoff_transport "$repo"
  if [[ "$TRANSPORT" == "legacy" ]]; then
    local hint msg
    hint="$(legacy_mode_hint "$repo")"
    if [[ -n "$value" ]]; then
      msg="run mode requires managed A2A setup (this repository uses legacy direct Claude, which has no saved run mode). To migrate: $hint"
      [[ $json -eq 1 ]] && json_die mode "$msg" 2
      echo "handoff: $msg" >&2
      exit 2
    fi
    if [[ $json -eq 1 ]]; then
      jq -n --arg schema "$CLI_OUTPUT_SCHEMA" --arg repo "$repo" --arg hint "To migrate: $hint" \
        '{schema: $schema, kind: "mode", repo: $repo, transport: "legacy", managed: false, mode: null,
          changed: false, previous: null, hint: $hint}'
      return 0
    fi
    echo "mode:    not set (legacy; run mode requires managed A2A setup)"
    echo "hint:    to migrate: $hint"
    return 0
  fi
  local -a pass=("$repo")
  [[ -n "$value" ]] && pass+=("$value")
  [[ $json -eq 1 ]] && pass+=(--json)
  a2a_manage mode "${pass[@]}"
}

init_choices_hint() {
  local repo="$1"
  cat >&2 <<EOF
handoff: choose how to set up $repo (no terminal to ask on):
  handoff init "$repo" --transport a2a --executor <claude|codex|cursor> --model "<model-id>" [--mode <drive|watch>] [--planner <cursor|codex|claude>]
  handoff init "$repo" --transport legacy
or let your Planner agent ask you: handoff skill install "$repo" --host <cursor|codex|claude>, then /handoff-cli set up handoff
list model IDs first: handoff models "$repo" --provider <claude|codex|cursor>
nothing was changed
EOF
}

# Preamble lines with CR stripped, plus a sentinel so trailing blank lines survive
# command substitution. Exit 1 when ## Current Task is missing or duplicated.
preamble_normalized() {
  awk '
    function norm(s) { sub(/\r$/, "", s); return s }
    BEGIN { seen = 0 }
    {
      line = norm($0)
      if (line == "## Current Task") { seen++; next }
      if (seen == 0) printf "%s\n", line
    }
    END { if (seen != 1) exit 1 }
  ' "$1" && printf '\034'
}

# One extra line when an existing HANDOFF.md preamble is not the template's.
# Line endings alone are not a difference. No temp files: a locked-down TMPDIR
# must not make init fail.
preamble_refresh_hint() {
  local repo="$1" tmpl="$TEMPLATE_DIR/HANDOFF.md" old new
  [[ -f "$repo/HANDOFF.md" && -f "$tmpl" ]] || return 0
  old="$(preamble_normalized "$repo/HANDOFF.md")" || {
    echo "preamble differs from the template; handoff template refresh \"$repo\""
    return 0
  }
  new="$(preamble_normalized "$tmpl")" || {
    echo "preamble differs from the template; handoff template refresh \"$repo\""
    return 0
  }
  if [[ "$old" == "$new" ]]; then
    return 0
  fi
  echo "preamble differs from the template; handoff template refresh \"$repo\""
}

# Octal mode of an existing file. macOS stat, GNU stat, then Python.
file_mode() {
  local file="$1" mode=""
  mode="$(stat -f '%Lp' "$file" 2>/dev/null || true)"
  if [[ -z "$mode" ]]; then
    mode="$(stat -c '%a' "$file" 2>/dev/null || true)"
  fi
  if [[ -z "$mode" ]]; then
    mode="$(python3 -c 'import os, sys; print(format(os.stat(sys.argv[1]).st_mode & 0o777, "o"))' "$file")"
  fi
  printf '%s' "$mode"
}

# "crlf" or "lf". A raw newline cannot be returned through command substitution.
heading_ending() {
  local file="$1" heading="$2" n raw
  n="$(heading_line "$file" "$heading")"
  raw="$(sed -n "${n}p" "$file"; printf x)"
  raw="${raw%x}"
  if [[ "$raw" == *$'\r'* ]]; then
    printf 'crlf'
  else
    printf 'lf'
  fi
}

cmd_template() {
  local sub="${1:-}"
  shift || true
  case "$sub" in
    refresh) cmd_template_refresh "$@" ;;
    *) die "unknown template command: ${sub:-} (try --help)" ;;
  esac
}

cmd_template_refresh() {
  local repo_arg="" json=0 a
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      -*) die "unknown template option: $a (try --help)" ;;
      *)
        [[ -z "$repo_arg" ]] || die "template refresh takes one repo path"
        repo_arg="$a" ;;
    esac
  done
  local repo given="${repo_arg:-$PWD}"
  if [[ $json -eq 1 ]]; then
    command -v jq >/dev/null || die "jq is required for --json (brew install jq)"
    repo="$(cd "$given" 2>/dev/null && pwd)" || json_die template_refresh "no such directory: $given"
  else
    repo="$(cd "$given" 2>/dev/null && pwd)" || die "no such directory: $given"
  fi
  local handoff="$repo/HANDOFF.md" tmpl="$TEMPLATE_DIR/HANDOFF.md"
  if [[ ! -f "$handoff" ]]; then
    if [[ $json -eq 1 ]]; then json_die template_refresh "no HANDOFF.md in $repo"; fi
    die "no HANDOFF.md in $repo (run 'handoff init $repo' first?)"
  fi
  [[ -f "$tmpl" ]] || die "template not found: $tmpl"
  if [[ -f "$repo/.handoff-logs/outstanding.json" ]]; then
    local msg="outstanding A2A run; refusing to refresh (run 'handoff status', 'handoff resume', or 'handoff cancel' first)"
    if [[ $json -eq 1 ]]; then json_die template_refresh "$msg"; fi
    die "$msg"
  fi
  local count
  count="$(heading_count "$handoff" "## Current Task")"
  if [[ "$count" != "1" ]]; then
    local msg
    if [[ "$count" == "0" ]]; then
      msg="no '## Current Task' line in $handoff; refusing to refresh"
    else
      msg="'## Current Task' appears $count times in $handoff; refusing to refresh"
    fi
    if [[ $json -eq 1 ]]; then json_die template_refresh "$msg"; fi
    die "$msg"
  fi
  local old new
  old="$(preamble_normalized "$handoff")" || die "no '## Current Task' line in $handoff; refusing to refresh"
  new="$(preamble_normalized "$tmpl")" || die "template has no single '## Current Task' line: $tmpl"
  if [[ "$old" == "$new" ]]; then
    if [[ $json -eq 1 ]]; then
      jq -n --arg schema "$CLI_OUTPUT_SCHEMA" --arg repo "$repo" \
        '{schema: $schema, kind: "template_refresh", repo: $repo, replaced: false, message: "already current"}'
    else
      echo "already current"
    fi
    return 0
  fi
  local ending line mode old_size new_size
  ending="$(heading_ending "$handoff" "## Current Task")"
  line="$(heading_line "$handoff" "## Current Task")"
  mode="$(file_mode "$handoff")"
  mkdir -p "$repo/.handoff-logs"
  local stamp backup tmp
  stamp="$(date -u +%Y%m%dT%H%M%SZ)"
  backup="$repo/.handoff-logs/HANDOFF.preamble-$stamp.md"
  cp "$handoff" "$backup"
  tmp="$(mktemp "$repo/.handoff-logs/HANDOFF.md.XXXXXX")"
  awk -v kind="$ending" '
    function norm(s) { sub(/\r$/, "", s); return s }
    BEGIN { end = (kind == "crlf" ? "\r\n" : "\n") }
    {
      line = norm($0)
      if (line == "## Current Task") exit
      printf "%s%s", line, end
    }
  ' "$tmpl" > "$tmp"
  tail -n +"$line" "$handoff" >> "$tmp"
  if [[ "$line" == "1" ]]; then
    old_size=0
  else
    old_size="$(head -n $((line - 1)) "$handoff" | wc -c | tr -d ' ')"
  fi
  local kept
  kept="$(tail -n +"$line" "$handoff" | wc -c | tr -d ' ')"
  new_size="$(wc -c < "$tmp" | tr -d ' ')"
  new_size=$((new_size - kept))
  chmod "$mode" "$tmp"
  mv "$tmp" "$handoff"
  if [[ $json -eq 1 ]]; then
    jq -n --arg schema "$CLI_OUTPUT_SCHEMA" --arg repo "$repo" --arg backup "$backup" \
      --argjson old_preamble_bytes "$old_size" --argjson new_preamble_bytes "$new_size" \
      '{schema: $schema, kind: "template_refresh", repo: $repo, replaced: true,
        backup: $backup, old_preamble_bytes: $old_preamble_bytes, new_preamble_bytes: $new_preamble_bytes,
        message: "replaced the preamble; Current Task and everything after it are unchanged"}'
  else
    echo "replaced the preamble; Current Task and everything after it are unchanged"
    echo "backup: $backup"
    echo "preamble: $old_size bytes -> $new_size bytes"
  fi
}

cmd_init() {
  local repo="" transport="" planner="" mode="" arg
  local -a choice=()
  while [[ $# -gt 0 ]]; do
    arg="$1"
    case "$arg" in
      --transport) transport="${2:-}"; shift 2 || die "--transport needs a value" ;;
      --transport=*) transport="${arg#*=}"; shift ;;
      --planner) planner="${2:-}"; choice+=("$arg" "${2:-}"); shift 2 || die "--planner needs a value" ;;
      --planner=*) planner="${arg#*=}"; choice+=("$arg"); shift ;;
      --mode) mode="${2:-}"; choice+=("$arg" "${2:-}"); shift 2 || die "--mode needs a value" ;;
      --mode=*) mode="${arg#*=}"; choice+=("$arg"); shift ;;
      --executor | --model | --reasoning-effort | --port)
        [[ $# -ge 2 ]] || die "$arg needs a value"
        choice+=("$arg" "$2"); shift 2 ;;
      --executor=* | --model=* | --reasoning-effort=* | --port=*) choice+=("$arg"); shift ;;
      -*) die "unknown init option: $arg (try --help)" ;;
      *)
        [[ -z "$repo" ]] || die "init takes one repo path (got '$repo' and '$arg')"
        repo="$arg"; shift ;;
    esac
  done
  local given="${repo:-$PWD}"
  repo="$(cd "$given" 2>/dev/null && pwd)" || die "no such directory: $given"
  repo="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)" || die "not a git repository: $repo"
  case "$planner" in "" | cursor | codex | claude | none) ;; *) die "unknown --planner '$planner' (cursor, codex, claude, or none)" ;; esac
  case "$mode" in "" | drive | watch) ;; *) die "unknown --mode '$mode' (drive or watch)" ;; esac
  if git -C "$repo" ls-files --error-unmatch .handoff-config.json >/dev/null 2>&1; then
    die ".handoff-config.json is already tracked; refuse to treat secrets as git-excluded"
  fi

  if [[ -z "$transport" ]]; then
    local has_executor_choice=0 c
    for c in ${choice[@]+"${choice[@]}"}; do
      case "$c" in --executor* | --model* | --reasoning-effort* | --port* | --mode*) has_executor_choice=1 ;; esac
    done
    if [[ $has_executor_choice -eq 1 ]]; then
      transport="a2a"
    elif [[ -f "$repo/HANDOFF.md" ]]; then
      transport="existing" # bare re-init: nondestructive
    elif [[ -t 0 && -t 1 ]]; then
      local answer="?"
      echo "Transport: A2A (recommended) = a Claude/Codex/Cursor Executor, model switching, a saved run mode,"
      echo "           and resumable runs through a local service; legacy = direct Claude only."
      while [[ "$answer" != "a2a" && "$answer" != "legacy" ]]; do
        read -r -p "Transport [A2A/legacy] (Enter = A2A): " answer </dev/tty
        answer="$(printf '%s' "$answer" | tr '[:upper:]' '[:lower:]')"
        [[ -z "$answer" ]] && answer="a2a"
      done
      transport="$answer"
    else
      init_choices_hint "$repo"
      exit 2
    fi
  fi

  if [[ "$transport" == "legacy" && -n "$mode" ]]; then
    die "run mode requires managed A2A setup; legacy has no saved run mode (drive or watch is followed by your Planner for the conversation). Use: $(legacy_mode_hint "$repo")"
  fi
  case "$transport" in
    legacy) cmd_init_legacy "$repo" "$planner" ;;
    existing)
      ensure_excludes "$repo" HANDOFF.md HANDOFF-ARCHIVE.md .handoff-logs/ .claude/settings.local.json .handoff-config.json
      if [[ -f "$repo/.handoff-config.json" ]] && jq -e '.managed != null' "$repo/.handoff-config.json" >/dev/null 2>&1; then
        a2a_manage setup "$repo" --template "$TEMPLATE_DIR/HANDOFF.md" ${choice[@]+"${choice[@]}"}
      else
        if [[ -n "$planner" && "$planner" != "none" ]]; then install_planner_skill_legacy "$repo" "$planner"; fi
        echo "already initialized: $repo/HANDOFF.md (ensured local excludes; nothing else changed)"
        preamble_refresh_hint "$repo"
        echo "managed A2A setup: handoff init \"$repo\" --transport a2a --executor <provider> --model \"<model-id>\""
      fi
      ;;
    a2a)
      local -a interactive=()
      local c2 missing=1
      for c2 in ${choice[@]+"${choice[@]}"}; do case "$c2" in --model*) missing=0 ;; esac; done
      if [[ ! -f "$repo/.handoff-config.json" ]] || ! jq -e '.managed != null' "$repo/.handoff-config.json" >/dev/null 2>&1; then
        if [[ $missing -eq 1 ]]; then
          if [[ -t 0 && -t 1 ]]; then
            interactive=(--interactive)
          else
            init_choices_hint "$repo"
            exit 2
          fi
        fi
      fi
      a2a_manage setup "$repo" --template "$TEMPLATE_DIR/HANDOFF.md" ${interactive[@]+"${interactive[@]}"} ${choice[@]+"${choice[@]}"}
      if jq -e 'has("claude")' "$repo/.handoff-logs/server.json" >/dev/null 2>&1; then
        cmd_permissions "$repo"
      fi
      ;;
    *) die "unknown --transport '$transport' (a2a or legacy)" ;;
  esac
}

cmd_init_legacy() {
  local repo="$1" planner="${2:-}"
  ensure_excludes "$repo" HANDOFF.md HANDOFF-ARCHIVE.md .handoff-logs/ .claude/settings.local.json .handoff-config.json
  if [[ -n "$planner" && "$planner" != "none" ]]; then
    install_planner_skill_legacy "$repo" "$planner"
  fi
  if [[ -f "$repo/HANDOFF.md" ]]; then
    echo "already initialized: $repo/HANDOFF.md (ensured local excludes, including .handoff-config.json)"
    preamble_refresh_hint "$repo"
    return 0
  fi
  [[ -f "$TEMPLATE_DIR/HANDOFF.md" ]] || die "template not found: $TEMPLATE_DIR/HANDOFF.md"

  cp "$TEMPLATE_DIR/HANDOFF.md" "$repo/HANDOFF.md"
  echo "initialized: $repo/HANDOFF.md (excluded locally via $(git_exclude_file "$repo"))"
  cmd_permissions "$repo"
}

command="${1:-}"
shift || true
case "$command" in
  execute | resume)
    "cmd_$command" "$@"
    ;;
  runs | watch | permissions | approve | cancel)
    "cmd_$command" "${1:-}"
    ;;
  status) cmd_status "$@" ;;
  preflight) cmd_preflight "$@" ;;
  mode) cmd_mode "$@" ;;
  skill) cmd_skill "$@" ;;
  init) cmd_init "$@" ;;
  template) cmd_template "$@" ;;
  archive) cmd_archive "$@" ;;
  qa) cmd_qa "$@" ;;
  models | model | server | planner) a2a_manage "$command" "$@" ;;
  -h | --help | "") usage ;;
  *) die "unknown subcommand: $command (try --help)" ;;
esac
