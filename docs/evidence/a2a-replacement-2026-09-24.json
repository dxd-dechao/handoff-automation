      "diff": "diff --git a/pricing.py b/pricing.py\nindex 0b81198..37698bd 100644\n--- a/pricing.py\n+++ b/pricing.py\n@@ -3,4 +3,7 @@\n \n def total(items):\n     \"\"\"Return the order total for (unit_price, quantity) pairs.\"\"\"\n-    raise NotImplementedError\n+    for unit_price, quantity in items:\n+        if quantity < 0:\n+            raise ValueError(\"quantity must not be negative\")\n+    return sum(unit_price * quantity for unit_price, quantity in items)\ndiff --git a/test_pricing.py b/test_pricing.py\nindex 622f03d..19da804 100644\n--- a/test_pricing.py\n+++ b/test_pricing.py\n@@ -10,6 +10,10 @@ class TotalTest(unittest.TestCase):\n     def test_empty_order_is_zero(self):\n         self.assertEqual(total([]), 0)\n \n+    def test_negative_quantity_raises(self):\n+        with self.assertRaises(ValueError):\n+            total([(1.0, -1)])\n+\n \n if __name__ == \"__main__\":\n     unittest.main()",
